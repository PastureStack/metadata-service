#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/version"

cd "$(dirname "$0")/.."

if [ -n "${CROSS:-}" ]; then
    rm -rf bin/linux bin/windows
    for platform in linux/amd64 windows/amd64; do
        os="${platform%/*}"
        arch="${platform#*/}"
        output="bin/${os}/${arch}/metadata-service"
        if [ "${os}" = windows ]; then
            output="${output}.exe"
        fi
        mkdir -p "$(dirname "${output}")"
        printf 'Building %s...\n' "${platform}"
        GOOS="${os}" GOARCH="${arch}" CGO_ENABLED=0 \
            go build -trimpath -buildvcs=false \
            -ldflags "-X main.VERSION=${VERSION} -s -w" \
            -o "${output}" .
    done
    exit 0
fi

mkdir -p bin
CGO_ENABLED=0 go build -trimpath -buildvcs=false \
    -ldflags "-X main.VERSION=${VERSION} -s -w" \
    -o bin/metadata-service .

#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Running tests with the race detector"
test_output=$(go test -race -cover ./...)
printf '%s\n' "${test_output}"

assert_coverage() {
    local package=$1
    local minimum=$2
    local actual
    actual=$(awk -v package="${package}" '
        $1 == "ok" && $2 == package {
            for (field = 1; field <= NF; field++) {
                if ($field == "coverage:") {
                    value = $(field + 1)
                    sub(/%$/, "", value)
                    print value
                    exit
                }
            }
        }
    ' <<<"${test_output}")
    if [ -z "${actual}" ] || ! awk -v actual="${actual}" -v minimum="${minimum}" 'BEGIN { exit !(actual >= minimum) }'; then
        printf 'Coverage for %s is %s%%; required minimum is %s%%\n' "${package}" "${actual:-missing}" "${minimum}" >&2
        exit 1
    fi
}

assert_coverage github.com/PastureStack/metadata-service 40
assert_coverage github.com/PastureStack/metadata-service/internal/platformevents 60
assert_coverage github.com/PastureStack/metadata-service/pkg/kicker 80

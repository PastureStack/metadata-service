#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Running validation"

echo "Running: go vet"
go vet ./...
echo "Running: gofmt"
mapfile -t go_files < <(find . -name '*.go' -not -path './vendor/*' -print)
unformatted="$(gofmt -l -- "${go_files[@]}")"
if [ -n "$unformatted" ]; then
    printf 'Unformatted Go files:\n%s\n' "$unformatted" >&2
    exit 1
fi
echo "Running: go mod verify"
go mod verify
bash ./scripts/verify-licenses
